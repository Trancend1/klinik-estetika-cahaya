# Neon database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# NextAuth.js
NEXTAUTH_SECRET=generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Untuk development lokal, ganti ke: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# WhatsApp admin klinik
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx

# Email notifikasi booking (opsional — Resend)
RESEND_API_KEY=re_xxxxx
CONTACT_EMAIL_TO=admin@klinikcahaya.id

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (untuk OG & sitemap)
NEXT_PUBLIC_SITE_URL=https://klinikestetikacahaya.id
