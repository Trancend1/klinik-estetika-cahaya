# Supabase — buat project di supabase.com lalu copy values dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# KRITIS: hanya dipakai di server-side (API routes). JANGAN expose ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# WhatsApp admin klinik
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx

# Email notifikasi booking (opsional — Resend)
RESEND_API_KEY=re_xxxxx
CONTACT_EMAIL_TO=admin@klinikcahaya.id

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (untuk OG & sitemap)
NEXT_PUBLIC_SITE_URL=https://klinikestetikacahaya.id
